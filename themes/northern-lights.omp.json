        //     "linux": "\ue712",
        //     "macos": "\ue711",
        //     "manjaro": "\uf312",
        //     "mint": "\uf30f",
        //     "opensuse": "\uf314",
        //     "raspbian": "\uf315",
        //     "ubuntu": "\uf31c",
        //     "windows": "\ue70f"
        //   },
        //   "template": "{{ if .WSL }}<p:color-alert-accent>\ue712{{ end }}{{ .Icon }}",
        //   "foreground": "p:color-dark",
        //   "powerline_symbol": "<r>\ue0b2</r>",
        //   "background": "p:color-light",
        //   "style": "powerline"
        // },
        {
          "type": "battery",
          "alias": "battery_percentage",
          "properties": {
            "cache_duration": "3s" //,
            // "charged_icon": "\udb80\udc79",
            // "charging_icon": "\udb80\udc84",
            // "discharging_icon": "\udb80\udc83",
            // "display_error": false,
            // "not_charging_icon": "\udb80\udc91"
          },
          //"template": "{{ if not .Error }}{{ .Icon }}<f>{{ .Percentage }}{{ .Var.Percent_Icon }}</f>{{ end }}{{ .Error }}",
          "template": "{{ if eq \"True\" (title (default \"False\" .Env.DISABLE_SEGMENT_BATTERY)) }}{{ else }}{{ if not .Error }}{{ if eq \"Charging\" .State.String }}\uE315{{ else if eq \"Discharging\" .State.String }}\uF062 {{ else if eq \"Full\" .State.String }}~ {{ else }}? {{ end }}{{ if lt .Percentage 15 }}\uF579{{ else if and (gt .Percentage 16) (lt .Percentage 30) }}\uF57A{{ else if and (gt .Percentage 31) (lt .Percentage 45) }}\uF57C{{ else if and (gt .Percentage 46) (lt .Percentage 55)}}\uF57D{{ else if and (gt .Percentage 56) (lt .Percentage 70) }}\uF57E{{ else if and (gt .Percentage 71) (lt .Percentage 90) }}\uF580{{ else }}\uF581{{ end }}{{ .Percentage }}%{{ else }}!{{ end }}{{ end }}",
          "powerline_symbol": "<r>\ue0b2</r>",
          "style": "powerline",
          "foreground_templates": [
            "{{ if .Error }}p:color-battery-state-error{{ end }}",
            "{{ if lt .Percentage 15 }}p:color-battery-15-less{{ end }}",
            "{{ if and (gt .Percentage 16) (lt .Percentage 30) }}p:color-battery-30-less{{ end }}",
            "{{ if and (gt .Percentage 31) (lt .Percentage 45) }}p:color-battery-45-less{{ end }}",
            "{{ if and (gt .Percentage 46) (lt .Percentage 55) }}p:color-battery-55-less{{ end }}",
            "{{ if and (gt .Percentage 56) (lt .Percentage 70) }}p:color-battery-70-less{{ end }}",
            "{{ if and (gt .Percentage 71) (lt .Percentage 90) }}p:color-battery-90-less{{ end }}",
            "{{ if and (gt .Percentage 91) (lt .Percentage 99) }}p:color-battery-100-less{{ end }}",
            "{{ if eq .Percentage 100  }}p:color-battery-100{{ end }}",
            "{{if eq \"Full\" .State.String}}parentForeground{{end}}"
          ],
          "background_templates": [
            "{{if eq \"Charging\" .State.String}}parentBackground{{end}}",
            "{{if eq \"Discharging\" .State.String}}parentBackground{{end}}",
            "{{if eq \"Full\" .State.String}}parentBackground{{end}}"
          ]
        },
        {
          "type": "sysinfo",
          "alias": "memory_usage_percent",
          "properties": {
            "cache_duration": "0h0m3s",
            "precision": 2
          },
          "template": "{{ .Var.RAM_Icon }}{{ round .PhysicalPercentUsed .Precision }}{{ .Var.Percent_Icon }}",
          "foreground": "p:color-dark",
          "background": "p:color-light",
          "style": "powerline",
          "powerline_symbol": "<r>\ue0b2</r>"
        },
        {
          "type": "connection",
          "alias": "wifi_ethernet_cellular_connection",
          "properties": {
            "cache_duration": "none"
          },
          "template": "{{ if eq .Type \"wifi\" }}{{ .Var.WiFi }}{{ else if eq .Type \"ethernet\" }}{{ .Var.ethernet }}{{ else if eq .Type \"cellular\" }}<p:color-alert-accent>{{ .Var.cellular }}{{ end }}{{ .Var.HairSpace }}{{ .Var.HairSpace }}",
          "foreground": "parentForeground",
          "background": "parentBackground",
          "style": "powerline",
          "powerline_symbol": "<r>\ue0b2</r>"
        },
        {
          "type": "time",
          "alias": "current_date_with_calendar",
          "properties": {
            "cache_duration": "none",
            "time_format": "Mon Jan 2"
          },
          "template": "{{ .Var.Calendar_Icon }}{{ .Var.HairSpace }}{{ .CurrentDate | date .Format }}",
          "foreground": "p:color-light",
          "background": "p:color-dark",
          "style": "powerline",
          "powerline_symbol": "<r>\ue0b2</r>"
        } //,
        // {
