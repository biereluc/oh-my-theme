        //       "C:\\temp": "\udb86\uddcb "
        //     },
        //     "mapped_locations_enabled": true,
        //     "mixed_threshold": 4,
        //     "style": "unique"
        //   },
        //   "template": "{{ .Var.HairSpace }}{{ if .Writable }}{{else}}<p:color-alert-accent>\uf023{{ .Var.HairSpace }}{{end}}{{ path .Path .Location}}</>{{ .Var.HairSpace }}",
        //   "foreground": "p:color-dark",
        //   "background": "p:color-light",
        //   "style": "powerline",
        //   "powerline_symbol": "\ue0b0"
        // },
        {
          "properties": {
            "always_enabled": true,
            "cache_duration": "none",
            "style": "austin",
            "threshold": 1
          },
          "template": "{{ .Var.HairSpace }}{{ if ne .FormattedMs \"0ms\" }}\ufbab{{ else }}<p:color-alert-accent>\ufbab</>{{ end }}{{ .Var.HairSpace }}{{ .FormattedMs }}{{ .Var.HairSpace }}",
          "foreground": "p:color-light",
          "powerline_symbol": "\ue0b0",
          "background": "p:color-dark",
          "type": "executiontime",
          "style": "powerline"
        },
        {
          "properties": {
            "always_enabled": true,
            "cache_duration": "none"
          },
          "trailing_diamond": "\ue0b4",
          "template": "{{ .Var.HairSpace }}{{ if gt .Code 0 }}\uf00d{{ .Var.HairSpace }}{{ .Meaning }}{{ else }}\uf42e{{ end }}",
          "foreground": "p:color-dark",
          "type": "exit",
          "style": "diamond",
          "background_templates": [
            "{{ if gt .Code 0 }}p:color-alert-accent{{ else }}p:color-light{{ end }}"
          ]
        }
      ]
    },
    {
      "type": "prompt",
      "alias": "right_prompt_decorations",
      "alignment": "right",
      "overflow": "hide",
      "segments": [
