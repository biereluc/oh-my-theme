        //   "foreground_templates": [
        //     "{{ if or (gt (now).Hour 17) (lt (now).Hour 6) }}p:color-night-light{{ else }}p:color-day-light{{ end }}"
        //   ],
        //   "background": "parentBackground",
        //   "style": "diamond",
        //   "powerline_symbol": "<r>\ue0b2</r>",
        //   "trailing_diamond": "\ue0b4"
        // }
      ]
    },
    {
      "type": "prompt",
      "alias": "left_prompt_decorations",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "{{ if eq .Var.IsShowPromptCount \"yes\" }}<p:color-light>{{ .PromptCount }}</>{{ .Var.HairSpace }}{{ end }}{{ .Var.BigArrow }}",
          "type": "text",
          "style": "plain",
          "foreground_templates": [
            "{{ if .Root }}p:color-alert-accent{{ else }}p:color-light{{ end }}"
          ]
        }
      ],
      "newline": true
    }
  ],
  "version": 3,
  "final_space": true
}
