    "nf-pom-internal_interruption": "\ue009",
    "transient_prompt_symbol": "\ue285 ",
    "valid_line_symbol": "\uf00c",
    "error_line_symbol": "\uea87 ❯",
    "secondary_prompt_symbol": "+   ",
    "Clock": "\uf017",
    "WiFi": "\uf1eb",
    "ethernet": "\udb80\ude00",
    "ethernet2": "\udb80\ude01",
    "ethernet3": "\uef44",
    "cellular": "\udb82\udcbf",
    "Root_Symbol": "\ued25",
    "RAM_Icon": "\udb80\udf5b",
    "Percent_Icon": "\uf295",
    "Terminal_icon": "\uea85",
    "Lightning_icon": "\uf0e7",
    "Calendar_Icon": "\udb80\udced"
  },
  "palettes": {
    "list": {
      "Goodmorningsunshine": {
        "background": "p:color-dark",
        "color-dark": "#003543",
        "foreground": "p:color-light",
        "color-light": "#9affdc",
        "color-night-light": "#90A4AE",
        "color-day-light": "#FFC300",
        "color-alert-accent": "#ff6b6b"
      },
      "Halo": {
        "background": "p:color-dark",
        "color-dark": "#2f3e46",
        "foreground": "p:color-light",
        "color-light": "#84a98c",
        "color-night-light": "#90A4AE",
        "color-day-light": "#FFC300",
        "color-alert-accent": "#ff7f51"
      },
      "RedWine": {
        "color-dark": "#03071e",
        "color-light": "#9d0208",
        "color-alert-accent": "#e85d04"
      },
      "aaa": {
        "background": "p:color-dark",
        "color-dark": "#2b2d42",
        "foreground": "p:color-light",
        "color-light": "#8d99ae",
        "color-night-light": "#90A4AE",
        "color-day-light": "#FFC300",
        "color-alert-accent": "#d90429"
      },
      "midnight": {
        "background": "p:color-dark",
        "color-dark": "#003543",
        "foreground": "p:color-light",
        "color-light": "#9affdc",
        "color-night-light": "#90A4AE",
        "color-day-light": "#FFC300",
        "color-alert-accent": "#ff6b6b"
      }
    },
    "template": "{{- $theme := (split \"|\" \"RedWine|Goodmorningsunshine|Halo|midnight|aaa\") -}}{{ $theme }}"
  },
