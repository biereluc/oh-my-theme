    "color-battery-45-less": "#9f565c",
    "color-battery-55-less": "#805057",
    "color-battery-70-less": "#604951",
    "color-battery-90-less": "#40424c",
    "color-battery-100-less": "#203b47",
    "color-battery-100": "#003442"
  },
  "var": {
    "IsShowPromptCount": "yes",
    "lightning": "⚡",
    "HairSpace": "\u2008",
    "BigArrow": "─❯",
    "PlusCross": "\uf0e7",
    "nf_fa_plus": "\uf067",
    "SunUnicode": "\u2600",
    "Sun_nf_fa_sun": "\udb81\udda8",
    "Sun": "\ufaa7",
    "Moon_nf-fa-moon": "\uf186",
    "Moon": "\ue285",
