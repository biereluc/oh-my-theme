{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "color-dark": "#003543",
    "color-light": "#9affdc",
    "background": "p:color-dark",
    "foreground": "p:color-light",
    "color-night-light": "#90A4AE",
    "color-day-light": "#FFC300",
    "color-alert-accent": "#ff6b6b",
    "color-battery-state-error": "#ff6b6b",
