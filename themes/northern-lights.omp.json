// https://www.compart.com/en/unicode/
//https://colordesigner.io/gradient-generator
{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "final_space": true,
  "pwd": "osc51",
  "terminal_background": "darkGray",
  "accent_color": "#003543",
  "shell_integration": true,
  "enable_cursor_positioning": true,
  "patch_pwsh_bleed": true,
  "console_title_template": "{{if .Root }}{{ .Var.emoji_lightning }} Admin : {{ end }}{{ .Shell }}",
  "upgrade": {
    "notice": true,
    "interval": "168h",
    "auto": false,
    "source": "github"
  },
  "debug_prompt": {
    "background": "transparent",
    "foreground": "#ffffff",
    "template": "Debugging "
  },
  "version": 3,
  "palette": {
    "color-dark": "#003543",
    "color-light": "#9affdc",
    "background": "p:color-dark",
    "foreground": "p:color-light",
    "color-night-light": "#90A4AE",
    "color-day-light": "#FFC300",
    "color-alert-accent": "#ff6b6b",
    "color-warning-accent": "#FFC300",
    "color-battery-state-error": "#ff6b6b",
    "color-battery-15-less": "#df6466",
    "color-battery-30-less": "#bf5d61",
    "color-battery-45-less": "#9f565c",
    "color-battery-55-less": "#805057",
    "color-battery-70-less": "#604951",
    "color-battery-90-less": "#40424c",
    "color-battery-100-less": "#203b47",
    "color-battery-100": "#003442",
    "color-exec-normal": "#FFC300",
    "color-exec-slow": "#905359",
    "color-exec-longer": "#ff6b6b"
  },
  "var": {
    "var_enable_prompt_count": "true",
    "HairSpace": "\u2008",
    "emoji_lightning": "⚡",
    "symbol_prompt_arrow": "❯",
    "symbol_valid_line_arrow": "\uf00c",
    "symbol_error_line_arrow": "\uea87 ❯",
    "symbol_transient_prompt": "\ue285 ",
    "symbol_secondary_prompt_plus": "+   ",
    "ico_shield": "\ued25",
    "ico_ssh": "\ueba9",
    "ico_lightning": "\uf0e7",
    "ico_timer_sand": "\udb81\udead",
    "ico_check": "\uf42e",
    "ico_error": "\uf00d",
    "ico_terminal": "\uea85",
    "ico_memory": "\udb80\udf5b",
    "ico_percent": "\uf295",
    "ico_wifi_network": "\uf1eb",
    "ico_ethernet_network": "\udb80\ude00",
    "ico_cellular_network": "\udb82\udcbf",
    "ico_calendar": "\udb80\udced",
    "ico_clock": "\uf017",
    "ico_sun": "\ufaa7",
    "ico_moon": "\ue285\uf186",
    "ethernet2": "\udb80\ude01",
    "ethernet3": "\uef44"
  },
  "palettes": {
    "list": {
      "Goodmorningsunshine": {
        "background": "p:color-dark",
        "color-dark": "#003543",
        "foreground": "p:color-light",
        "color-light": "#9affdc",
        "color-night-light": "#90A4AE",
        "color-day-light": "#FFC300",
        "color-alert-accent": "#ff6b6b"
      },
      "Halo": {
        "background": "p:color-dark",
        "color-dark": "#2f3e46",
        "foreground": "p:color-light",
        "color-light": "#84a98c",
        "color-night-light": "#90A4AE",
        "color-day-light": "#FFC300",
        "color-alert-accent": "#ff7f51"
      },
      "RedWine": {
        "color-dark": "#03071e",
        "color-light": "#9d0208",
        "color-alert-accent": "#e85d04"
      },
      "aaa": {
        "background": "p:color-dark",
        "color-dark": "#2b2d42",
        "foreground": "p:color-light",
        "color-light": "#8d99ae",
        "color-night-light": "#90A4AE",
        "color-day-light": "#FFC300",
        "color-alert-accent": "#d90429"
      },
      "midnight": {
        "background": "p:color-dark",
        "color-dark": "#003543",
        "foreground": "p:color-light",
        "color-light": "#9affdc",
        "color-night-light": "#90A4AE",
        "color-day-light": "#FFC300",
        "color-alert-accent": "#ff6b6b"
      }
    },
    "template": "{{- $theme := (split \"|\" \"RedWine|Goodmorningsunshine|Halo|midnight|aaa\") -}}{{ $theme }}"
  },
  "valid_line": {
    "foreground": "p:color-light",
    "background": "transparent",
    "template": "{{ .Var.symbol_valid_line_arrow }}"
  },
  "error_line": {
    "foreground": "p:color-alert-accent",
    "background": "transparent",
    "template": "{{ .Var.symbol_error_line_arrow }}"
  },
  "secondary_prompt": {
    "foreground": "p:color-light",
    "background": "transparent",
    "template": "{{ .Var.symbol_secondary_prompt_plus }}"
  },
  "transient_prompt": {
    "background": "transparent",
    "foreground": "p:color-light",
    "foreground_templates": [
      "{{ if .Root }}p:color-alert-accent{{ end }}"
    ],
    "template": "{{ if eq .Var.var_enable_prompt_count \"true\" }}<p:color-light>{{ .PromptCount }}</>{{ .Var.HairSpace }}{{ end }}{{ .Var.symbol_transient_prompt }}"
  },
  "blocks": [
    {
      "alias": "Debug Block",
      "type": "prompt",
      "newline": false,
      "alignment": "left",
      "force": true,
      "segments": [
        {
          "alias": "root_variable_segment",
          "type": "text",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "foreground": "p:color-dark",
          "background": "p:color-warning-accent",
          "template": "{{.}}"
        }
      ]
    },
    {
      "alias": "left_prompt_decorations",
      "type": "prompt",
      "newline": true,
      "alignment": "left",
      "overflow": "hide",
      "force": true,
      "segments": [
        {
          "alias": "new_latest_upgrade_segment",
          "type": "upgrade",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "foreground": "p:color-dark",
          "background": "p:color-warning-accent",
          "properties": {
            "cache_duration": "168h"
          },
          "template": "\uf019 {{ .Latest }}{{ .Var.HairSpace }}"
        },
        {
          "alias": "admin_icon_segment",
          "type": "text",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "foreground": "p:color-dark",
          "background": "p:color-dark",
          "background_templates": [
            "{{ if .Root }}p:color-alert-accent{{ end }}"
          ],
          "properties": {
            "cache_duration": "none"
          },
          "template": "{{ if .Root }}{{ .Var.ico_shield }}{{ end }}{{ .Var.HairSpace }}"
        },
        {
          "alias": "run_as_whois_segment",
          "type": "session",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:color-light",
          "background": "p:color-dark",
          "properties": {
            "cache_duration": "none"
          },
          "templates": [
            "{{ if .Root }}<p:color-alert-accent>{{ .Var.HairSpace }}</>{{ end }}",
            "{{ if .SSHSession }}<p:color-alert-accent>{{ .Var.ico_ssh }}{{ .Var.HairSpace }}</>{{ end }}",
            "{{ .UserName }}{{ if .Root }}<p:color-alert-accent>{{ .Var.ico_lightning }}</>{{ else }}@{{ end }}{{ .HostName }}{{ .Var.HairSpace }}"
          ]
        },
        {
          "alias": "current_directory_segment",
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:color-dark",
          "background": "p:color-light",
          "properties": {
            "cache_duration": "none",
            "style": "mixed",
            "mixed_threshold": 3,
            "folder_icon": "\u2026",
            "folder_separator_icon": "<p:color-dark>\ue0b1</>",
            "windows_registry_icon": "\u2026",
            "interactive": true,
            "stack_count_enabled": true,
            "mapped_locations_enabled": true,
            "home_icon": "\uf015",
            "mapped_locations": {
              "C:\\Users": "\uf007 ",
              "C:\\Windows": "\ue62a ",
              "C:\\Windows\\temp": "\udb86\uddcb ",
              "C:\\temp": "\udb86\uddcb "
            }
          },
          "template": "{{ .Var.HairSpace }}{{ if .Writable }}{{else}}<p:color-alert-accent>\uf023{{ .Var.HairSpace }}{{end}}{{ path .Path .Location}}{{ .Var.HairSpace }}</>"
        },
        {
          "alias": "execution_time_segment",
          "type": "executiontime",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:color-light",
          "foreground_templates": [
            "{{ if lt .Ms 30000 }}p:color-light{{ end }}",
            "{{ if lt .Ms 3600000 }}p:color-exec-normal{{ end }}",
            "{{ if lt .Ms 10800000 }}p:color-exec-slow{{ end }}",
            "{{ if gt .Ms 10800001 }}p:color-exec-longer{{ end }}"
          ],
          "background": "p:color-dark",
          "properties": {
            "always_enabled": true,
            "cache_duration": "none",
            "threshold": 1,
            "style": "austin"
          },
          "template": "{{ .Var.HairSpace }}{{ if eq .FormattedMs \"0ms\" }}<p:color-alert-accent>{{ .Var.ico_timer_sand }}{{ else }}<p:color-light>{{ .Var.ico_timer_sand }}{{ end }}{{ .Var.HairSpace }}</>{{ .FormattedMs }}{{ .Var.HairSpace }}"
        },
        {
          "type": "exit",
          "alias": "exit_code_segment",
          "properties": {
            "always_enabled": true,
            "cache_duration": "none"
          },
          "template": "{{ .Var.HairSpace }}{{ if gt .Code 0 }}{{ .Var.ico_error }}{{ .Var.HairSpace }}{{ .Meaning }}{{ else }}{{ .Var.ico_check }}{{ end }}",
          "foreground": "p:color-dark",
          "background": "p:color-dark",
          "background_templates": [
            "{{ if gt .Code 0 }}p:color-alert-accent{{ else }}p:color-light{{ end }}"
          ],
          "style": "diamond",
          "trailing_diamond": "\ue0b4"
        }
      ]
    },
    {
      "type": "prompt",
      "alias": "right_prompt_decorations",
      "alignment": "right",
      "overflow": "hide",
      "segments": [
        {
          "alias": "shell_name_segment",
          "type": "shell",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "foreground": "p:color-light",
          "background": "p:color-dark",
          "properties": {
            "cache_duration": "none",
            "mapped_shell_names": {
              "bash": "Bash",
              "powershell": "PS",
              "pwsh": "PWSH"
            }
          },
          "template": "{{ .Var.ico_terminal }}{{ .Var.HairSpace }}{{ .Name }}{{ .Var.HairSpace }}"
        },
        {
          "alias": "operating_system_icon",
          "type": "os",
          "style": "powerline",
          "powerline_symbol": "<r>\ue0b2</r>",
          "foreground": "p:color-dark",
          "background": "p:color-light",
          "properties": {
            "cache_duration": "none",
            "cache_strategy": "session"
          },
          "template": "{{ if .WSL }}<p:color-alert-accent>\ue712{{ .Var.HairSpace }}</>{{ end }}{{ .Icon }}{{ .Var.HairSpace }}"
        },
        {
          "alias": "battery_percentage",
          "type": "battery",
          "powerline_symbol": "<r>\ue0b2</r>",
          "style": "powerline",
          "properties": {
            "cache_duration": "3s" //,
          },
          "template": "{{ if eq \"True\" (title (default \"False\" .Env.DISABLE_SEGMENT_BATTERY)) }}{{ else }}{{ if not .Error }}{{ if eq \"Charging\" .State.String }}\uE315{{ else if eq \"Discharging\" .State.String }}\uF062 {{ else if eq \"Full\" .State.String }}~ {{ else }}? {{ end }}{{ if lt .Percentage 15 }}\uF579{{ else if and (gt .Percentage 16) (lt .Percentage 30) }}\uF57A{{ else if and (gt .Percentage 31) (lt .Percentage 45) }}\uF57C{{ else if and (gt .Percentage 46) (lt .Percentage 55)}}\uF57D{{ else if and (gt .Percentage 56) (lt .Percentage 70) }}\uF57E{{ else if and (gt .Percentage 71) (lt .Percentage 90) }}\uF580{{ else }}\uF581{{ end }}{{ .Percentage }}{{ .Var.ico_percent }}{{ else }}!{{ end }}{{ end }}",
          "foreground_templates": [
            "{{ if .Error }}p:color-battery-state-error{{ end }}",
            "{{ if lt .Percentage 15 }}p:color-battery-15-less{{ end }}",
            "{{ if and (gt .Percentage 16) (lt .Percentage 30) }}p:color-battery-30-less{{ end }}",
            "{{ if and (gt .Percentage 31) (lt .Percentage 45) }}p:color-battery-45-less{{ end }}",
            "{{ if and (gt .Percentage 46) (lt .Percentage 55) }}p:color-battery-55-less{{ end }}",
            "{{ if and (gt .Percentage 56) (lt .Percentage 70) }}p:color-battery-70-less{{ end }}",
            "{{ if and (gt .Percentage 71) (lt .Percentage 90) }}p:color-battery-90-less{{ end }}",
            "{{ if and (gt .Percentage 91) (lt .Percentage 99) }}p:color-battery-100-less{{ end }}",
            "{{ if eq .Percentage 100  }}p:color-battery-100{{ end }}",
            "{{if eq \"Full\" .State.String}}parentForeground{{end}}"
          ],
          "background_templates": [
            "{{if eq \"Charging\" .State.String}}parentBackground{{end}}",
            "{{if eq \"Discharging\" .State.String}}parentBackground{{end}}",
            "{{if eq \"Full\" .State.String}}parentBackground{{end}}"
          ]
        },
        {
          "alias": "memory_usage_percent",
          "type": "sysinfo",
          "style": "powerline",
          "powerline_symbol": "<r>\ue0b2</r>",
          "properties": {
            "cache_duration": "0h0m3s",
            "precision": 2
          },
          "template": "{{ .Var.ico_memory }}{{ round .PhysicalPercentUsed .Precision }}{{ .Var.ico_percent }}",
          "foreground": "p:color-dark",
          "background": "p:color-light"
        },
        {
          "type": "connection",
          "alias": "network_connection_type",
          "style": "powerline",
          "powerline_symbol": "<r>\ue0b2</r>",
          "properties": {
            "cache_duration": "none"
          },
          "template": "{{ if eq .Type \"wifi\" }}{{ .Var.ico_wifi_network }}{{ else if eq .Type \"ethernet\" }}{{ .Var.ico_ethernet_network }}{{ else if eq .Type \"cellular\" }}{{ .Var.ico_cellular_network }}{{ end }}{{ .Var.HairSpace }}{{ .Var.HairSpace }}",
          "foreground": "parentForeground",
          "foreground_templates": [
            "{{ if eq .Type \"cellular\" }}p:color-alert-accent{{ end }}",
            "{{ if eq .Type \"wifi\" }}p:color-day-light{{ end }}"
          ],
          "background": "parentBackground"
        },
        {
          "type": "spotify",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#ffffff",
          "background": "#1BD760",
          "properties": {
            "playing_icon": "\uE602 ",
            "paused_icon": "\uF8E3 ",
            "stopped_icon": "\uF04D "
          },
          "template": "{{ .Icon }}{{ if ne .Status \"stopped\" }}{{ .Track }}{{ end }}"
        },
        {
          "type": "time",
          "alias": "current_date_with_calendar",
          "properties": {
            "cache_duration": "none",
            "time_format": "Mon Jan 2"
          },
          "template": "{{ .Var.ico_calendar }}{{ .Var.HairSpace }}{{ .CurrentDate | date .Format }}",
          "foreground": "p:color-light",
          "background": "p:color-dark",
          "style": "powerline",
          "powerline_symbol": "<r>\ue0b2</r>"
        },
        {
          "type": "time",
          "alias": "current_time_with_clock",
          "properties": {
            "cache_duration": "none",
            "time_format": "15:04:05·PM"
          },
          "template": "{{ .Var.HairSpace }}{{ .Varico_clock }}{{ .Var.HairSpace }}{{ .CurrentDate | date .Format }}",
          "foreground": "parentForeground",
          "background": "parentBackground",
          "style": "powerline"
        },
        {
          "type": "time",
          "alias": "beauty_end_line_sun_moon",
          "properties": {
            "cache_duration": "none"
          },
          "template": " {{ if or (gt (now).Hour 17) (lt (now).Hour 6) }}{{ .Var.ico_moon }}{{ else }}{{ .Var.ico_sun }}{{ end }}",
          "foreground_templates": [
            "{{ if or (gt (now).Hour 17) (lt (now).Hour 6) }}p:color-night-light{{ else }}p:color-day-light{{ end }}"
          ],
          "background": "parentBackground",
          "style": "diamond",
          "powerline_symbol": "<r>\ue0b2</r>",
          "trailing_diamond": "\ue0b4"
        }
      ]
    },
    {
      "alias": "read_prompt",
      "type": "prompt",
      "newline": true,
      "alignment": "left",
      "force": true,
      "segments": [
        {
          "alias": "prompt_line",
          "type": "text",
          "style": "plain",
          "foreground_templates": [
            "{{ if .Root }}p:color-alert-accent{{ else }}p:color-light{{ end }}"
          ],
          "background": "transparent",
          "properties": {
            "cache_duration": "none"
          },
          "template": "{{ .Var.symbol_prompt_arrow }}"
        }
      ]
    }
  ]
}
